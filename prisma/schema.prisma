// .clinika — schema base (Fase 0)
// Convenciones:
// - Todo modelo tenant-scoped lleva tenantId + policy RLS equivalente (ver prisma/migrations/*_rls).
// - El aislamiento real se refuerza en Postgres con RLS; este schema es la primera capa (app-level).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Rol restringido (clinika_app, sin BYPASSRLS) — usado en runtime.
  url       = env("DATABASE_URL")
  // Rol owner (clinika_owner) — solo para `prisma migrate`, nunca en runtime.
  // Si el owner tuviera BYPASSRLS y se usara en runtime, RLS quedaría decorativo.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Núcleo multi-tenant
// ---------------------------------------------------------------------------

// Tipo de centro (vertical). Define qué módulos, textos y panel de inicio ve.
// MEDICO = centros médicos existentes; ODONTOLOGIA = consultorios dentales;
// LABORATORIO = laboratorios dentales (reservado, se habilita en la fase E).
enum TipoCentro {
  MEDICO
  ODONTOLOGIA
  LABORATORIO
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  nombre    String
  logoUrl   String?
  activo    Boolean  @default(true)
  tipo      TipoCentro @default(MEDICO)
  // Fin de la prueba gratis (se fija al registrarse solo). La suscripción
  // completa llega en la fase D.
  trialHasta          DateTime?
  // Cuándo se cargó el catálogo de ejemplos de trabajos de laboratorio (una sola vez).
  catalogoLabCargadoEn DateTime?
  terminosAceptadosEn DateTime?
  terminosVersion     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships           Membership[]
  modulos               TenantModule[]
  pacientes             Paciente[]
  profesionales         Profesional[]
  practicas             Practica[]
  consultorios          Consultorio[]
  turnos                Turno[]
  estudios              Estudio[]
  estudioArchivos       EstudioArchivo[]
  estudioInformes       EstudioInforme[]
  estudioFirmas         EstudioFirma[]
  hallazgosDentales     HallazgoDental[]
  tiposTrabajo          TipoTrabajo[]
  laboratorios          Laboratorio[]
  pedidosLaboratorio    PedidoLaboratorio[]
  pedidoEstados         PedidoEstado[]
  pedidoMensajes        PedidoMensaje[]
  pedidoArchivos        PedidoArchivo[]
  facturas              Factura[]
  auditLogs             AuditLog[]
  pacientePortales      PacientePortal[]
  documentosCompartidos DocumentoCompartido[]
  obrasSociales         ObraSocial[]
  afiliaciones          Afiliacion[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  activo       Boolean  @default(true)
  // null = todavía no confirmó su mail (aviso suave, no bloquea el uso).
  emailVerificadoEn DateTime?
  createdAt    DateTime @default(now())

  memberships         Membership[]
  profesional         Profesional?
  passwordResetTokens PasswordResetToken[]
  emailVerificacionTokens EmailVerificacionToken[]
}

// Confirmación de mail al registrarse. Global como PasswordResetToken (sin
// tenantId ni RLS); hash sha256 del token, un solo uso.
model EmailVerificacionToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Cuenta de intentos de registro por IP (límite anti-abuso del alta pública).
// Global, sin datos de salud.
model RegistroIntento {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

// Recuperación de contraseña del login de staff. Global como User (sin
// tenantId, sin policy de RLS) — el hash es sha256, no bcrypt: el token
// nace con 256 bits de entropía (crypto.randomBytes), así que no hace
// falta (ni conviene) pagar el costo de bcrypt como si fuera una
// contraseña humana. Un solo uso: se marca usedAt al resetear y ahí mismo
// se invalidan los demás tokens vigentes del mismo usuario.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum RolTenant {
  ADMIN
  SECRETARIA
  MEDICO
  AUDITOR
}

// Une un User a un Tenant con un rol. Permite que un profesional
// atienda en más de un centro con el mismo login (selector post-login).
model Membership {
  id        String    @id @default(cuid())
  userId    String
  tenantId  String
  rol       RolTenant
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

enum ModuloKey {
  PACIENTES
  TURNOS
  ESTUDIOS
  FACTURACION
  OBRAS_SOCIALES
  PORTAL_PACIENTE
  ODONTOGRAMA
  LABORATORIO
  RECETAS_INFORMES
  REPORTES
  INTEGRACIONES_DICOM
}

model TenantModule {
  id             String    @id @default(cuid())
  tenantId       String
  modulo         ModuloKey
  habilitado     Boolean   @default(false)
  activadoEn     DateTime?
  precioOverride Decimal?  @db.Decimal(10, 2)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, modulo])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Auditoría (desde Fase 0 — historia clínica es dato sensible)
// ---------------------------------------------------------------------------

enum AuditAction {
  VIEW
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id        String      @id @default(cuid())
  tenantId  String
  userId    String?
  accion    AuditAction
  entidad   String // "Paciente" | "HistoriaClinicaEntry" | "Estudio" | ...
  entidadId String
  detalle   Json?
  ip        String?
  createdAt DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entidad, entidadId])
  @@index([tenantId, userId, createdAt])
}

// ---------------------------------------------------------------------------
// Núcleo clínico (Fase 1: Pacientes + Turnos + Estudios + Facturación básica)
// ---------------------------------------------------------------------------

enum TipoDocumento {
  DNI
  PASAPORTE
  OTRO
}

enum Sexo {
  MASCULINO
  FEMENINO
  OTRO
}

model Paciente {
  id                         String        @id @default(cuid())
  tenantId                   String
  tipoDocumento              TipoDocumento @default(DNI)
  // Opcional: el alta rápida (consultorios dentales) pide solo nombre y teléfono.
  dni                        String?
  nombre                     String
  apellido                   String
  fechaNacimiento            DateTime?
  sexo                       Sexo?
  domicilio                  String?
  telefono                   String?
  email                      String?
  contactoEmergenciaNombre   String?
  contactoEmergenciaTelefono String?
  alergias                   String?
  // Campo libre para tenants sin el módulo OBRAS_SOCIALES activado.
  // Cuando el módulo esté activo, se usa el modelo Afiliacion (fase 3).
  obraSocialTexto            String?
  // Dato de ejemplo cargado al registrarse; se borra con un clic.
  esDemo                     Boolean       @default(false)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  turnos       Turno[]
  estudios     Estudio[]
  facturas     Factura[]
  historia     HistoriaClinicaEntry[]
  portal       PacientePortal?
  afiliaciones Afiliacion[]
  hallazgosDentales HallazgoDental[]
  pedidosLaboratorio PedidoLaboratorio[]

  @@unique([tenantId, dni])
  @@index([tenantId])
}

// Catálogo de obras sociales que atiende el centro (fase 3). Solo tiene
// sentido si el módulo OBRAS_SOCIALES está habilitado — si no, el paciente
// sigue usando el campo libre Paciente.obraSocialTexto.
model ObraSocial {
  id       String  @id @default(cuid())
  tenantId String
  nombre   String
  activo   Boolean @default(true)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  afiliaciones Afiliacion[]

  @@index([tenantId])
}

// Un paciente puede tener más de una (ej: obra social + prepaga
// complementaria), por eso es una relación aparte y no un campo suelto.
model Afiliacion {
  id             String   @id @default(cuid())
  tenantId       String
  pacienteId     String
  obraSocialId   String
  numeroAfiliado String
  plan           String?
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paciente   Paciente   @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  obraSocial ObraSocial @relation(fields: [obraSocialId], references: [id])

  @@index([tenantId, pacienteId])
}

// Login del Portal del Paciente. Deliberadamente SIN policy de RLS —
// como User, es una tabla global sin datos clínicos (solo credenciales +
// a qué tenant/paciente corresponde), así que el login puede buscar por
// username sin necesitar ya un tenant activo seteado (mismo problema que
// resolvimos para User/Membership en el login de staff). Ningún dato de
// salud vive acá: eso sigue 100% detrás de RLS en Paciente/Turno/Estudio,
// a los que solo se accede después de autenticado, vía withTenantContext.
model PacientePortal {
  id           String   @id @default(cuid())
  tenantId     String
  pacienteId   String   @unique
  // Memorable a propósito (inicial + DNI) para que no se lo olviden — la
  // seguridad la da la contraseña random, no el usuario.
  username     String   @unique
  passwordHash String
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
}

model Profesional {
  id           String  @id @default(cuid())
  tenantId     String
  userId       String? @unique
  nombre       String
  apellido     String
  matricula    String?
  especialidad String?
  activo       Boolean @default(true)

  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User?                  @relation(fields: [userId], references: [id])
  turnos             Turno[]
  estudiosInformados Estudio[]              @relation("EstudioInformadoPor")
  historia           HistoriaClinicaEntry[]
  hallazgosDentales  HallazgoDental[]

  @@index([tenantId])
}

// La unidad configurable multiespecialidad: cada centro carga su propio
// catálogo de prácticas sobre la misma base de pacientes/turnos/facturación.
model Practica {
  id                     String  @id @default(cuid())
  tenantId               String
  nombre                 String
  especialidadKey        String? // libre por ahora; catálogo formal en fase 5 (Odontograma)
  duracionMin            Int     @default(30)
  precioParticular       Decimal @db.Decimal(10, 2)
  requiereEstudio        Boolean @default(false)
  requiereAutorizacionOS Boolean @default(false)
  activo                 Boolean @default(true)
  // Mediciones típicas de esta práctica (ej: "Fémur derecho", "Diámetro
  // biparietal") para precargar filas vacías al abrir un informe nuevo —
  // el médico las completa o las saca, no son obligatorias ni validadas.
  camposSugeridosInforme String[] @default([])

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  turnos       Turno[]
  estudios     Estudio[]
  facturaItems FacturaItem[]

  @@index([tenantId])
}

// Dónde queda cada consultorio/sala físico del centro — hoy solo para
// asignárselo a un turno; el kiosco de autocheck-in (fase 2, pendiente)
// lo va a usar para indicarle al paciente a dónde ir.
model Consultorio {
  id       String  @id @default(cuid())
  tenantId String
  nombre   String
  piso     String?
  activo   Boolean @default(true)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  turnos Turno[]

  @@index([tenantId])
}

enum EstadoTurno {
  RESERVADO
  CONFIRMADO
  EN_ESPERA
  EN_ATENCION
  ATENDIDO
  CANCELADO
  AUSENTE
}

model Turno {
  id                   String      @id @default(cuid())
  tenantId             String
  pacienteId           String
  profesionalId        String
  practicaId           String
  consultorioId        String?
  fechaHora            DateTime
  duracionMin          Int
  estado               EstadoTurno @default(RESERVADO)
  origen               String? // "secretaria" | "kiosco" | "portal"
  notas                String?
  // Número que da la obra social al autorizar (por teléfono, web, etc.) —
  // solo aplica si Practica.requiereAutorizacionOS. Sin workflow de estados
  // propio: si la práctica lo requiere y esto está vacío, se considera
  // pendiente (ver badge en la agenda).
  numeroAutorizacionOS String?
  esDemo               Boolean     @default(false)
  createdAt            DateTime    @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paciente    Paciente     @relation(fields: [pacienteId], references: [id])
  profesional Profesional  @relation(fields: [profesionalId], references: [id])
  practica    Practica     @relation(fields: [practicaId], references: [id])
  consultorio Consultorio? @relation(fields: [consultorioId], references: [id])
  estudios    Estudio[]
  facturas    Factura[]

  @@index([tenantId, profesionalId, fechaHora])
  @@index([tenantId, pacienteId])
}

enum EstadoEstudio {
  PENDIENTE
  INFORMADO
}

model Estudio {
  id             String        @id @default(cuid())
  tenantId       String
  turnoId        String?
  pacienteId     String
  practicaId     String
  modalidad      String?
  estado         EstadoEstudio @default(PENDIENTE)
  informadoPorId String?
  informadoEn    DateTime?
  informeTexto   String?
  createdAt      DateTime      @default(now())

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  turno        Turno?           @relation(fields: [turnoId], references: [id])
  paciente     Paciente         @relation(fields: [pacienteId], references: [id])
  practica     Practica         @relation(fields: [practicaId], references: [id])
  informadoPor Profesional?     @relation("EstudioInformadoPor", fields: [informadoPorId], references: [id])
  // Una radiografía/ecografía suele traer varias imágenes, no una sola —
  // por eso es una relación 1-a-muchos y no un campo archivoUrl suelto
  // (que es lo que había antes). Permite subir varias juntas o ir
  // agregando después sin tocar el estudio en sí.
  archivos     EstudioArchivo[]
  // Adjuntos opcionales: PDFs de informe externo (ej: ya vienen firmados de
  // otro sistema o dictados). Independiente de informeTexto, que es lo que
  // el médico escribe y firma acá mismo — pueden coexistir. Puede haber más
  // de uno (ej: informe + imágenes clave anexas).
  informes     EstudioInforme[]
  firma        EstudioFirma?

  @@index([tenantId, pacienteId])
  @@index([tenantId, estado])
}

model EstudioArchivo {
  id        String   @id @default(cuid())
  tenantId  String
  estudioId String
  key       String
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  estudio Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  @@index([tenantId, estudioId])
}

model EstudioInforme {
  id        String   @id @default(cuid())
  tenantId  String
  estudioId String
  key       String
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  estudio Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  @@index([tenantId, estudioId])
}

// Timeline clínico único del paciente. Recetas/Informes (fase 6) y
// Odontograma (fase 5) cuelgan acá como "tipo" de entrada, no como tablas aparte.
enum TipoHistoriaClinica {
  NOTA
  DIAGNOSTICO
  INDICACION
  RECETA
  ORDEN_MEDICA
  // Tratamiento realizado sobre una o más piezas dentales (odontograma).
  PRESTACION
}

model HistoriaClinicaEntry {
  id              String              @id @default(cuid())
  tenantId        String
  pacienteId      String
  profesionalId   String
  tipo            TipoHistoriaClinica
  contenido       String
  // El médico decide, entrada por entrada, si el paciente la ve en su
  // Portal — no es un interruptor general del paciente (fase 2, portal).
  visibleEnPortal Boolean             @default(false)
  // Piezas dentales (numeración FDI) a las que se refiere la entrada.
  piezas          Int[]               @default([])
  esDemo          Boolean             @default(false)
  fecha           DateTime            @default(now())

  paciente    Paciente             @relation(fields: [pacienteId], references: [id])
  profesional Profesional          @relation(fields: [profesionalId], references: [id])
  compartido  DocumentoCompartido?

  @@index([tenantId, pacienteId, fecha])
}

// Puente público para el link compartible (/documento/[token]) de una
// Receta u Orden médica — mismo motivo que PacientePortal: la pantalla es
// pública (el paciente la abre sin login) y necesita resolver el tenant
// ANTES de tener contexto de tenant seteado, así que esta tabla queda
// deliberadamente SIN policy de RLS. No guarda ningún dato clínico, solo
// el puntero; el contenido real se lee después vía withTenantContext.
model DocumentoCompartido {
  id                     String   @id @default(cuid())
  tenantId               String
  historiaClinicaEntryId String   @unique
  token                  String   @unique
  createdAt              DateTime @default(now())

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entrada HistoriaClinicaEntry @relation(fields: [historiaClinicaEntryId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Facturación básica (particular únicamente en Fase 1)
// ---------------------------------------------------------------------------

enum EstadoFactura {
  PENDIENTE
  PAGADA
  ANULADA
}

model Factura {
  id         String        @id @default(cuid())
  tenantId   String
  pacienteId String
  turnoId    String?
  montoTotal Decimal       @db.Decimal(10, 2)
  estado     EstadoFactura @default(PENDIENTE)
  createdAt  DateTime      @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paciente Paciente      @relation(fields: [pacienteId], references: [id])
  turno    Turno?        @relation(fields: [turnoId], references: [id])
  items    FacturaItem[]
  pagos    Pago[]

  @@index([tenantId, pacienteId])
}

model FacturaItem {
  id         String  @id @default(cuid())
  facturaId  String
  practicaId String
  monto      Decimal @db.Decimal(10, 2)

  factura  Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  practica Practica @relation(fields: [practicaId], references: [id])
}

model Pago {
  id        String   @id @default(cuid())
  facturaId String
  metodo    String // "efectivo" | "tarjeta" | "transferencia"
  monto     Decimal  @db.Decimal(10, 2)
  fecha     DateTime @default(now())

  factura Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)
}

// Notas de la página temporal /circuito (revisión del circuito entre Jona y
// su papá). Global a propósito: no es dato de ningún centro ni de pacientes,
// y se borra junto con la página cuando ya no haga falta.
model CircuitoNota {
  id        String   @id @default(cuid())
  seccion   String
  autor     String
  texto     String
  createdAt DateTime @default(now())

  @@index([seccion, createdAt])
}

// Firma manuscrita (dibujada) del médico sobre un informe. Tabla aparte para
// que la imagen no viaje en cada listado de estudios. La hora exacta de la
// firma queda en Estudio.informadoEn (auditoría interna); no se muestra.
model EstudioFirma {
  id        String   @id @default(cuid())
  tenantId  String
  estudioId String   @unique
  imagen    String
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  estudio Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Odontograma (fase B del vertical dental)
// ---------------------------------------------------------------------------

enum SuperficieDental {
  VESTIBULAR
  LINGUAL // lingual (inferiores) o palatina (superiores)
  MESIAL
  DISTAL
  OCLUSAL // oclusal (posteriores) o incisal (anteriores)
}

enum TipoHallazgo {
  CARIES
  OBTURACION
  CORONA
  ENDODONCIA
  EXTRACCION
  AUSENTE
  IMPLANTE
  PROTESIS_FIJA
  PROTESIS_REMOVIBLE
  FRACTURA
  SELLADOR
  OTRO
}

// Convención argentina: rojo = patología o por hacer, azul = existente o ya hecho.
enum EstadoHallazgo {
  A_REALIZAR
  EXISTENTE
}

// Una fila por cada cosa que tiene o necesita una pieza. Solo se agrega: lo
// resuelto o corregido se cierra con anuladoEn y queda en el historial.
model HallazgoDental {
  id            String           @id @default(cuid())
  tenantId      String
  pacienteId    String
  profesionalId String
  // Numeración FDI: permanentes 11-48, temporales 51-85.
  pieza         Int
  // Vacío = pieza entera (corona, ausente, implante...).
  superficies   SuperficieDental[]
  tipo          TipoHallazgo
  estado        EstadoHallazgo
  nota          String?
  fecha         DateTime         @default(now())
  anuladoEn     DateTime?
  esDemo        Boolean          @default(false)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paciente    Paciente    @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  profesional Profesional @relation(fields: [profesionalId], references: [id])

  @@index([tenantId, pacienteId, pieza])
}

// ---------------------------------------------------------------------------
// Laboratorio dental (fase C del vertical dental)
// ---------------------------------------------------------------------------

// Laboratorio al que el consultorio le manda trabajos. Es un contacto del
// consultorio, no un usuario: el laboratorio entra por un link mágico (C4).
model Laboratorio {
  id             String   @id @default(cuid())
  tenantId       String
  nombre         String
  contacto       String?
  telefono       String?
  email          String?
  // Texto libre: "zirconio", "ortodoncia", "prótesis removible"...
  especialidades String[]
  notas          String?
  activo         Boolean  @default(true)
  esDemo         Boolean  @default(false)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tiposTrabajo TipoTrabajo[]
  pedidos      PedidoLaboratorio[]

  @@index([tenantId])
}

// Catálogo de trabajos que el consultorio pide al laboratorio. Arranca con
// ejemplos (sin precios) y cada consultorio los edita, borra o agrega.
model TipoTrabajo {
  id            String  @id @default(cuid())
  tenantId      String
  nombre        String
  categoria     String
  // Laboratorio al que se lo pedís siempre (se completa solo al hacer el pedido).
  laboratorioId String?
  activo        Boolean @default(true)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  laboratorio Laboratorio? @relation(fields: [laboratorioId], references: [id], onDelete: SetNull)
  pedidos     PedidoLaboratorio[]

  @@index([tenantId, categoria])
}

enum EstadoPedidoLab {
  ENVIADO
  RECIBIDO
  EN_PROCESO
  EN_PRUEBA
  TERMINADO
  ENTREGADO
  DEVUELTO // devuelto con observaciones
}

enum AutorMensaje {
  CONSULTORIO
  LABORATORIO
}

model PedidoLaboratorio {
  id            String          @id @default(cuid())
  tenantId      String
  // Correlativo por consultorio (el que se imprime en la orden).
  numero        Int
  pacienteId    String
  laboratorioId String
  tipoTrabajoId String?
  // Copia del nombre: si después editás o borrás el trabajo del catálogo, el pedido no cambia.
  trabajo       String
  piezas        Int[]
  color         String?
  notas         String?
  fechaEntrega  DateTime?
  estado        EstadoPedidoLab @default(ENVIADO)
  creadoPorId   String?
  creadoEn      DateTime        @default(now())
  actualizadoEn DateTime        @updatedAt
  entregadoEn   DateTime?
  esDemo        Boolean         @default(false)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paciente    Paciente        @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  laboratorio Laboratorio     @relation(fields: [laboratorioId], references: [id], onDelete: Restrict)
  tipoTrabajo TipoTrabajo?    @relation(fields: [tipoTrabajoId], references: [id], onDelete: SetNull)
  estados     PedidoEstado[]
  mensajes    PedidoMensaje[]
  archivos    PedidoArchivo[]

  @@unique([tenantId, numero])
  @@index([tenantId, estado])
  @@index([tenantId, pacienteId])
}

// Historial de estados: solo se agrega.
model PedidoEstado {
  id        String          @id @default(cuid())
  tenantId  String
  pedidoId  String
  estado    EstadoPedidoLab
  nota      String?
  // Quién lo cambió (nombre ya resuelto: después puede ser el laboratorio por el link).
  autor     String
  autorTipo AutorMensaje    @default(CONSULTORIO)
  creadoEn  DateTime        @default(now())

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pedido PedidoLaboratorio @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId, creadoEn])
}

model PedidoMensaje {
  id          String       @id @default(cuid())
  tenantId    String
  pedidoId    String
  autorTipo   AutorMensaje
  autorNombre String
  texto       String
  creadoEn    DateTime     @default(now())

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pedido PedidoLaboratorio @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId, creadoEn])
}

// Fotos, PDF y escaneos 3D (STL/PLY/OBJ) del pedido. El archivo vive en R2 (bucket privado).
model PedidoArchivo {
  id          String       @id @default(cuid())
  tenantId    String
  pedidoId    String
  key         String
  nombre      String
  contentType String
  tamano      Int
  subidoPor   String
  autorTipo   AutorMensaje @default(CONSULTORIO)
  creadoEn    DateTime     @default(now())

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pedido PedidoLaboratorio @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId, creadoEn])
}
