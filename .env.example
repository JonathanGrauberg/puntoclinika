# Conexión de RUNTIME (rol restringido, sin BYPASSRLS) — la usa la app.
DATABASE_URL="postgresql://clinika_app:PASSWORD@HOST/clinika?sslmode=require"

# Conexión de MIGRACIONES (rol owner, corre `prisma migrate`) — nunca la usa la app en runtime.
DIRECT_DATABASE_URL="postgresql://clinika_owner:PASSWORD@HOST/clinika?sslmode=require"

AUTH_SECRET="generar-con-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
