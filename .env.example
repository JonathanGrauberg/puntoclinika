# Conexión de RUNTIME (rol restringido, sin BYPASSRLS) — la usa la app.
DATABASE_URL="postgresql://clinika_app:PASSWORD@HOST/clinika?sslmode=require"

# Conexión de MIGRACIONES (rol owner, corre `prisma migrate`) — nunca la usa la app en runtime.
DIRECT_DATABASE_URL="postgresql://clinika_owner:PASSWORD@HOST/clinika?sslmode=require"

AUTH_SECRET="generar-con-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Cloudflare R2 (compatible con S3) para archivos de Estudios.
# Bucket privado — se accede siempre vía URLs firmadas (ver src/lib/storage.ts),
# nunca público, porque son estudios médicos.
R2_ACCOUNT_ID="tu-account-id-de-cloudflare"
R2_ACCESS_KEY_ID="access-key-del-token-r2"
R2_SECRET_ACCESS_KEY="secret-key-del-token-r2"
R2_BUCKET_NAME="clinika-estudios"
